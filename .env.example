# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# GitHub Personal Access Token (needs 'repo' scope for private repos, 'public_repo' for public)
GITHUB_TOKEN=ghp_your_token_here

# LLM Provider: "groq" for cloud inference, "ollama" for local
LLM_PROVIDER=groq

# Groq API key (get one free at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# FastAPI server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Confidence threshold — suggestions below this score are filtered out (0.0 to 1.0)
MIN_CONFIDENCE=0.5
